{
    "private": true,
    "scripts": {
        "dev": "npm run development",
        "development": "cross-env NODE_ENV=development node_modules/webpack/bin/webpack.js --progress --config=node_modules/laravel-mix/setup/webpack.config.js",
        "watch": "npm run development -- --watch",
        "watch-poll": "npm run watch -- --watch-poll",
        "localhost": "cross-env NODE_ENV=localhost node_modules/webpack/bin/webpack.js --progress --config=node_modules/laravel-mix/setup/webpack.config.js",
        "watch-localhost": "npm run localhost -- --watch",
        "hot": "cross-env NODE_ENV=development node_modules/webpack-dev-server/bin/webpack-dev-server.js --inline --hot --config=node_modules/laravel-mix/setup/webpack.config.js",
        "prod": "npm run production",
        "production": "cross-env NODE_ENV=production node_modules/webpack/bin/webpack.js --no-progress --config=node_modules/laravel-mix/setup/webpack.config.js",
        "stage": "npm run staging",
        "staging": "cross-env NODE_ENV=staging node_modules/webpack/bin/webpack.js --progress --config=node_modules/laravel-mix/setup/webpack.config.js",
        "startDev": "concurrently \"npm run watch\" \"php artisan serve\""
    },
    "devDependencies": {
        "axios": "^1.6.4",
        "deepmerge": "^4.3.1",
        "laravel-mix": "^6.0.49",
        "resolve-url-loader": "^5.0.0",
        "sass": "~1.32",
        "sass-loader": "^16.0.4",
        "vue-loader": "^15.11.1",
        "vue-template-compiler": "^2.7.16"
    },
    "dependencies": {
        "@fullcalendar/core": "^6.1.15",
        "@fullcalendar/daygrid": "^6.1.15",
        "@fullcalendar/interaction": "^6.1.15",
        "@fullcalendar/timegrid": "^6.1.15",
        "@fullcalendar/vue": "^6.1.15",
        "buffer": "^6.0.3",
        "chart.js": "^2.9.4",
        "cross-env": "^7.0.3",
        "date-fns": "^4.1.0",
        "dompurify": "^3.2.4",
        "marked": "^15.0.7",
        "process": "^0.11.10",
        "vue": "^2.7.16",
        "vue-avatar-component": "^1.3.1",
        "vue-chartjs": "^3.5.1",
        "vue-full-calendar": "^2.8.1-0",
        "vue-router": "^3.6.5",
        "vue-simple-calendar": "^7.1.0",
        "vue2-datepicker": "^3.11.1",
        "vuejs-datetimepicker": "^1.1.13",
        "vuetify": "^2.7.2"
    }
}
